# APproach : Two Pointers , array 
# Difficulty  : Easy
# Time Complexity : O(n)
# Space Complexity : O(1)

`python []

class Solution(object):
    def isPrefixString(self, s, words):
        i=0
        for j in words:
            for k in range(len(j)):

                if i >=len(s) or s[i]!=j[k]:
                    return False
                i+=1
            if i==len(s):
                return True
        return False

      
