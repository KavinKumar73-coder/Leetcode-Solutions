# Approach : Hash Map / Prefix sum
# Difficulty  : Medium
# Time Complexity : O(n)
# Space Complexity : O(n)


```python[]

class Solution(object):
    def leastBricks(self, wall):
        d={}
        for i in wall:
            pos=0
            for j in i[:-1]:
                pos=pos+j
                d[pos]=d.get(pos,0)+1
        if d:
            return len(wall)-max(d.values())
        else:
            return len(wall)



Input
wall =
[[1,2,2,1],[3,1,2],[1,3,2],[2,4],[3,1,2],[1,3,1,1]]
Output
2
