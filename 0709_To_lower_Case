# Approach : Traversal of String
# Difficulty : Easy
# Time Complexity : O(n)
# Space Complexity : O(n)

```python 

class Solution(object):
    def toLowerCase(self, s):
        res=""
        for ch in s:
            if 'A' <= ch <= 'Z':
                res+= chr(ord(ch) + 32)
            else:
                res+=ch
        return res



Input: s = "Hello"
Output: "hello"
