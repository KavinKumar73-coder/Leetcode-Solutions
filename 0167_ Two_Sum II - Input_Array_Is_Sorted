class Solution(object):
    def twoSum(self, numbers, target):
        left=0
        right=len(numbers)-1
        while left<right:
            tot=numbers[left]+numbers[right]
            if tot==target:
                return [left+1,right+1]
            elif tot>target:
                right-=1
            else:
                left+=1


