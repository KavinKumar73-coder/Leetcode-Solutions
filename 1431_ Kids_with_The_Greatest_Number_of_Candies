class Solution(object):
    def kidsWithCandies(self, candies, extraCandies):
        max_1=max(candies)
        for i in range(len(candies)):
            res= candies[i] + extraCandies
            if res>= max_1:
                candies[i]= True
            else:
                candies[i]= False
        return candies


  Input
candies =
[2,3,5,1,3]
extraCandies =
3
Output
[true,true,true,false,true]
