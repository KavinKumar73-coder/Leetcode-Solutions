# Approach : Array, Two Pointers
# Diificulty : Medium
# Time Complexity : O(n)
# Space COmplexity : O(1)

class Solution(object):
    def findUnsortedSubarray(self, nums):

        n = len(nums)

        left = -1
        right = -1

        max_num = float('-inf')
        min_num = float('inf')

        # Left to right
        for i in range(n):
            if nums[i] < max_num:
                right = i
            else:
                max_num = nums[i]

        # Right to left
        for i in range(n-1, -1, -1):
            if nums[i] > min_num:
                left = i
            else:
                min_num = nums[i]

        if left == -1:
            return 0

        return right - left + 1
