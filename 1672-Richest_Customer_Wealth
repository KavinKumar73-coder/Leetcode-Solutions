# Approach : Array , Matrix
# Difficulty : Easy
# Time Complexitu : O(m x n)
# Space Complexity : O(1)

```python 


class Solution(object):
    def maximumWealth(self, accounts):
        max_wealth = 0
        for i in accounts:
            res = 0
            for j in i:
                res += j

            if res > max_wealth:
               max_wealth = res
        return max_wealth


       

Input:
accounts =[[2,8,7],[7,1,3],[1,9,5]]
Output:
17
        


