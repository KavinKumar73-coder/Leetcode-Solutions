# Approach : Hash , Dict , Prefix Sum
# Difficulty : Medium
# Time Complexity : O(n)
# Space Complexity ; O(n)


`python []

class Solution(object):
    def findMaxLength(self, nums):
        d={0:-1}
        count=0
        ans=0
        for i in range(len(nums)):
            if nums[i]==0:
                count-=1
            else:
                count+=1
            if count in d:
                ans=max(ans,i-d[count])
            else:
                d[count]=i
        return ans



Input
nums =
[0,1,1,1,1,1,0,0,0]
Output
6
