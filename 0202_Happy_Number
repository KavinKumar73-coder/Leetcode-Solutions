class Solution(object):
    def isHappy(self, n):
        seen=set()
        while n!=1:
            if n in seen:
                return False
            seen.add(n)
            res=0
            while n>0:
                digi=n%10
                res=res + digi**2
                n=n//10
            n=res
        return True



