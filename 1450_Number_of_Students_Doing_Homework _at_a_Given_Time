# Approach : Array
# Difficulty : Easy
# Time Complexity : O(n)
# Space Complexity : O(1)


```python []

class Solution(object):
    def busyStudent(self, startTime, endTime, queryTime):
        count=0
        for i in range(len(startTime)):
            if startTime[i] <=  queryTime <= endTime[i]:
                count=count+1
        return count

       
 Input
startTime =[1,2,3]

endTime =[3,2,7]

queryTime =4

