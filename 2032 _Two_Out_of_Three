class Solution(object):
    def twoOutOfThree(self, nums1, nums2, nums3):
        count={}
        for i in (nums1,nums2,nums3):
            for j in set(i):
                  count[j]=count.get(j,0)+1
          
        return [j for j in count if count[j]>=2]


