# Approach : Node Traversal
# Difficulty : Easy
# Time Complexity : O(n)
# Space Complexity : O(1)

`python

class Solution:
    def deleteDuplicates(self, head):
        cur = head
        while cur and cur.next:
            if cur.val == cur.next.val:
                cur.next = cur.next.next
            else:
                cur = cur.next

        return head





        
        
