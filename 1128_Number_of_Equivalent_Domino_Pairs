class Solution(object):
    def numEquivDominoPairs(self, dominoes):
        count={}
        res=0
        for i in dominoes:
            x= ( min(i),max(i))
            if x in count:
                res=res+count[x]
            count[x]=count.get(x,0)+1
        return res




