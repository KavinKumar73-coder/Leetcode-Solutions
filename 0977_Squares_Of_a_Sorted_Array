# Approach : List Comprehension
# Time Complexity : O(n)
# Space Complexity : O(n)
# Difficulty : Easy

```python


class Solution(object):
    def sortedSquares(self, nums):
        nums=[i**2 for i in nums]
        nums.sort()
        return nums

Input:
nums =[-7,-3,2,3,11]
Output:
[4,9,9,49,121]
