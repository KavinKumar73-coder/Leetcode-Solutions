# Approach : Two Pointers
# Difficulty : Medium
# Time Complexity : O(n)
# Space Complexity :O(1)


```python []


class Solution(object):
    def removeDuplicates(self, nums):
        i=2
        for j in range(2,len(nums)):
            if nums[j]!=nums[i-2]:
                nums[i]=nums[j]
                i+=1
        return i


Input
nums =
[1,1,1,2,2,3]
Output
[1,1,2,2,3]
