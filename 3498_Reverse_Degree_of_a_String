# difficulty : O(n)
# Time Complexity :O(n)
# Space Complexity : O(1)


`python[]

class Solution(object):
    def reverseDegree(self, s):
        ans=0
        for i in range(1,len(s)+1):
            n=ord('z')-ord(s[i-1])+1
            ans=ans+n*i
        return ans



