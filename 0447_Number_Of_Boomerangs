class Solution(object):
    def numberOfBoomerangs(self, points):

        ans = 0

        for i in points:

            count = {}

            for j in points:

                x = i[0] - j[0]
                y = i[1] - j[1]

                distance = x*x + y*y

                count[distance] = count.get(distance, 0) + 1

            for value in count.values():

                ans += value * (value - 1)

        return ans



