# Approach : Set,Traversal
# Difficulty ; Easy
# Time Complexity : O(n)
# Space Complexity : O(n)


```python []

class Solution:
    def missingInteger(self, nums):
        total = nums[0]

        for i in range(1, len(nums)):
            if nums[i] == nums[i - 1] + 1:
                total += nums[i]
            else:
                break

        s = set(nums)

        while total in s:
            total += 1

        return total

   Input :
nums =[1,2,3,2,5]
Output
6
